// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > custom separator 1`] = `"<span class="strand-big-mono-time">1<span aria-hidden="true" class="strand-big-mono-time__sep">to</span>2</span>"`;

exports[`renders > range lg 1`] = `"<span class="strand-big-mono-time strand-big-mono-time--lg">06:45<span aria-hidden="true" class="strand-big-mono-time__sep">–</span>08:30</span>"`;

exports[`renders > single 1`] = `"<span class="strand-big-mono-time">06:45</span>"`;

exports[`renders > sm with datetime 1`] = `"<time datetime="2026-08-13T06:45" class="strand-big-mono-time strand-big-mono-time--sm">06:45</time>"`;
