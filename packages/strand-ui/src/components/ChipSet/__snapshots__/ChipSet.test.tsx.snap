// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > empty 1`] = `"<div aria-label="None" class="strand-chip-set" role="group"></div>"`;

exports[`renders > multi wrap 1`] = `"<div aria-label="Interests" class="strand-chip-set" role="group"><button aria-pressed="true" class="strand-chip-set__chip" type="button">Trails</button><button aria-pressed="false" class="strand-chip-set__chip" type="button">Chess</button></div>"`;

exports[`renders > single scroll sm 1`] = `"<div aria-label="Filter" class="strand-chip-set strand-chip-set--scroll strand-chip-set--sm strand-scroll-row" role="radiogroup"><button aria-checked="true" class="strand-chip-set__chip" role="radio" type="button">All</button><button aria-checked="false" class="strand-chip-set__chip" role="radio" type="button">Mine</button></div>"`;
