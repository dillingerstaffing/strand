// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > auto fit 1`] = `"<div class="strand-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--strand-space-3);">cells</div>"`;

exports[`renders > default 1`] = `"<div class="strand-grid" style="grid-template-columns: repeat(1, minmax(0, 1fr)); gap: var(--strand-space-4);">cells</div>"`;

exports[`renders > off ladder gap 1`] = `"<div class="strand-grid" style="grid-template-columns: repeat(1, minmax(0, 1fr)); gap: var(--strand-space-6);">cells</div>"`;

exports[`renders > sidebar 1`] = `"<div class="strand-grid strand-grid--sidebar" style="gap: var(--strand-space-4);">cells</div>"`;

exports[`renders > split 1`] = `"<div class="strand-grid strand-grid--split" style="gap: var(--strand-space-4);">cells</div>"`;

exports[`renders > three columns gap 6 1`] = `"<div class="strand-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--strand-space-6);">cells</div>"`;
