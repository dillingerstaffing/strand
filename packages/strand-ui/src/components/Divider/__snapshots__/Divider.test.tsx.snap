// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > horizontal 1`] = `"<hr aria-orientation="horizontal" class="strand-divider strand-divider--horizontal" role="separator">"`;

exports[`renders > labeled 1`] = `"<div aria-orientation="horizontal" class="strand-divider strand-divider--horizontal strand-divider--labeled" role="separator"><span class="strand-divider__line"></span><span class="strand-divider__label">OR</span><span class="strand-divider__line"></span></div>"`;

exports[`renders > vertical 1`] = `"<div aria-orientation="vertical" class="strand-divider strand-divider--vertical" role="separator"></div>"`;
