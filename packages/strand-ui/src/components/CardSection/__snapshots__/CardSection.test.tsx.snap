// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > body 1`] = `"<div class="strand-card__section">Body</div>"`;

exports[`renders > header 1`] = `"<div class="strand-card__section strand-card__section--header">Title</div>"`;

exports[`stylesheet > renders these rules 1`] = `".strand-card-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--strand-space-3); padding-bottom: var(--strand-space-2); border-bottom: 1px solid var(--strand-gray-200) }"`;
