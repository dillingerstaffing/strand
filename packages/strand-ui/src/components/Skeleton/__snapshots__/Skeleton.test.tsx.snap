// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > circle 1`] = `"<div aria-hidden="true" class="strand-skeleton strand-skeleton--circle strand-skeleton--shimmer" style="width: 48px; height: 48px;"></div>"`;

exports[`renders > rectangle 1`] = `"<div aria-hidden="true" class="strand-skeleton strand-skeleton--rectangle strand-skeleton--shimmer" style="width: 100%; height: 200px;"></div>"`;

exports[`renders > text 1`] = `"<div aria-hidden="true" class="strand-skeleton strand-skeleton--text strand-skeleton--shimmer" style="width: 100%;"></div>"`;
