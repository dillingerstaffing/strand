exports[`renders > read only sm 1`] = `"<div aria-label="Rated" class="strand-star-rating strand-star-rating--sm strand-star-rating--readonly" data-strand-component="star-rating" data-value="4" role="radiogroup"><button aria-checked="false" aria-label="1 star" class="strand-star-rating__star strand-star-rating__star--active" data-star-value="1" disabled="" role="radio" tabindex="-1" type="button"><span aria-hidden="true" class="strand-star-rating__glyph">★</span></button><button aria-checked="false" aria-label="2 stars" class="strand-star-rating__star strand-star-rating__star--active" data-star-value="2" disabled="" role="radio" tabindex="-1" type="button"><span aria-hidden="true" class="strand-star-rating__glyph">★</span></button><button aria-checked="false" aria-label="3 stars" class="strand-star-rating__star strand-star-rating__star--active" data-star-value="3" disabled="" role="radio" tabindex="-1" type="button"><span aria-hidden="true" class="strand-star-rating__glyph">★</span></button><button aria-checked="true" aria-label="4 stars" class="strand-star-rating__star strand-star-rating__star--active" data-star-value="4" disabled="" role="radio" tabindex="-1" type="button"><span aria-hidden="true" class="strand-star-rating__glyph">★</span></button><button aria-checked="false" aria-label="5 stars" class="strand-star-rating__star" data-star-value="5" disabled="" role="radio" tabindex="-1" type="button"><span aria-hidden="true" class="strand-star-rating__glyph">★</span></button></div>"`;

