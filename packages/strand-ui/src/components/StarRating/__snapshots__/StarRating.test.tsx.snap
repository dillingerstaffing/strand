exports[`renders > read only sm 1`] = `"<div class="strand-star-rating strand-star-rating--sm strand-star-rating--readonly" role="radiogroup" aria-label="Rated" data-strand-component="star-rating" data-value="4"><button type="button" class="strand-star-rating__star strand-star-rating__star--active" role="radio" aria-checked="false" aria-label="1 star" tabindex="-1" disabled="" data-star-value="1"><span class="strand-star-rating__glyph" aria-hidden="true">★</span></button><button type="button" class="strand-star-rating__star strand-star-rating__star--active" role="radio" aria-checked="false" aria-label="2 stars" tabindex="-1" disabled="" data-star-value="2"><span class="strand-star-rating__glyph" aria-hidden="true">★</span></button><button type="button" class="strand-star-rating__star strand-star-rating__star--active" role="radio" aria-checked="false" aria-label="3 stars" tabindex="-1" disabled="" data-star-value="3"><span class="strand-star-rating__glyph" aria-hidden="true">★</span></button><button type="button" class="strand-star-rating__star strand-star-rating__star--active" role="radio" aria-checked="true" aria-label="4 stars" tabindex="-1" disabled="" data-star-value="4"><span class="strand-star-rating__glyph" aria-hidden="true">★</span></button><button type="button" class="strand-star-rating__star" role="radio" aria-checked="false" aria-label="5 stars" tabindex="-1" disabled="" data-star-value="5"><span class="strand-star-rating__glyph" aria-hidden="true">★</span></button></div>"`;

