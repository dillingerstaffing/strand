// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > anchor 1`] = `"<a class="strand-btn strand-btn--primary strand-btn--md" href="/docs"><span class="strand-btn__content">Docs</span></a>"`;

exports[`renders > danger lg 1`] = `"<button class="strand-btn strand-btn--danger strand-btn--lg" type="button"><span class="strand-btn__content">Delete</span></button>"`;

exports[`renders > disabled 1`] = `"<button aria-disabled="true" class="strand-btn strand-btn--primary strand-btn--md" disabled="" type="button"><span class="strand-btn__content">Save</span></button>"`;

exports[`renders > disabled anchor 1`] = `"<a aria-disabled="true" class="strand-btn strand-btn--primary strand-btn--md"><span class="strand-btn__content">Docs</span></a>"`;

exports[`renders > full width submit 1`] = `"<button class="strand-btn strand-btn--primary strand-btn--md strand-btn--full-width" type="submit"><span class="strand-btn__content">Send</span></button>"`;

exports[`renders > ghost sm 1`] = `"<button class="strand-btn strand-btn--ghost strand-btn--sm" type="button"><span class="strand-btn__content">More</span></button>"`;

exports[`renders > icon only 1`] = `"<button aria-label="Close" class="strand-btn strand-btn--primary strand-btn--md strand-btn--icon-only" type="button"><span class="strand-btn__content">x</span></button>"`;

exports[`renders > loading 1`] = `"<button aria-busy="true" aria-disabled="true" class="strand-btn strand-btn--primary strand-btn--md strand-btn--loading" disabled="" type="button"><span aria-hidden="true" class="strand-btn__spinner"></span><span class="strand-btn__content" style="visibility: hidden;">Saving</span></button>"`;

exports[`renders > primary md 1`] = `"<button class="strand-btn strand-btn--primary strand-btn--md" type="button"><span class="strand-btn__content">Save</span></button>"`;

exports[`renders > secondary 1`] = `"<button class="strand-btn strand-btn--secondary strand-btn--md" type="button"><span class="strand-btn__content">Cancel</span></button>"`;
