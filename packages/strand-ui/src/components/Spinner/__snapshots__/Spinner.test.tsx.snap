// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > lg 1`] = `"<span class="strand-spinner strand-spinner--lg" role="status"><span aria-hidden="true" class="strand-spinner__ring"></span><span class="strand-spinner__sr-only">Loading</span></span>"`;

exports[`renders > md 1`] = `"<span class="strand-spinner strand-spinner--md" role="status"><span aria-hidden="true" class="strand-spinner__ring"></span><span class="strand-spinner__sr-only">Loading</span></span>"`;

exports[`renders > sm 1`] = `"<span class="strand-spinner strand-spinner--sm" role="status"><span aria-hidden="true" class="strand-spinner__ring"></span><span class="strand-spinner__sr-only">Loading</span></span>"`;

exports[`stylesheet > renders these rules 1`] = `
".strand-spinner { display: inline-flex; align-items: center; justify-content: center }
.strand-spinner__ring { display: block; border: 2px solid var(--strand-gray-200); border-top-color: var(--strand-blue-primary); border-radius: var(--strand-radius-full); animation: strand-spinner-rotate 0.8s linear infinite }
.strand-spinner--sm .strand-spinner__ring { width: 16px; height: 16px }
.strand-spinner--md .strand-spinner__ring { width: 20px; height: 20px }
.strand-spinner--lg .strand-spinner__ring { width: 32px; height: 32px }
@keyframes strand-spinner-rotate {
  to { transform: rotate(360deg) }
}
.strand-spinner__sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0 }
@media (prefers-reduced-motion: reduce) {
  .strand-spinner__ring { animation: none; border-style: dotted }
}"
`;
