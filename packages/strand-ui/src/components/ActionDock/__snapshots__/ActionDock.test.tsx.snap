// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > hidden by default 1`] = `"<div class="strand-actiondock" data-strand-actiondock="hidden">Action</div>"`;

exports[`renders > visible 1`] = `"<div class="strand-actiondock" data-strand-actiondock="visible">Action</div>"`;

exports[`stylesheet > renders these rules 1`] = `
".strand-actiondock { position: fixed; inset-inline: 0; bottom: 0; z-index: 90; background: var(--strand-surface-elevated); border-block-start: 1px solid var(--strand-border-subtle); box-shadow: var(--strand-elevation-3, 0 -8px 28px rgba(15, 23, 42, 0.12)); padding: var(--strand-space-4); padding-block-end: calc( var(--strand-space-4) + env(safe-area-inset-bottom, 0px) ); transform: translateY(100%); visibility: hidden; transition: transform var(--strand-duration-normal, 200ms) var(--strand-ease-out-quart, ease-out), visibility var(--strand-duration-normal, 200ms) }
.strand-actiondock[data-strand-actiondock="visible"] { transform: translateY(0); visibility: visible }"
`;
