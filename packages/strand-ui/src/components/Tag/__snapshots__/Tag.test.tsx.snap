// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > amber 1`] = `"<span class="strand-tag strand-tag--solid strand-tag--amber"><span class="strand-tag__text">T</span></span>"`;

exports[`renders > blue 1`] = `"<span class="strand-tag strand-tag--solid strand-tag--blue"><span class="strand-tag__text">T</span></span>"`;

exports[`renders > outlined teal 1`] = `"<span class="strand-tag strand-tag--outlined strand-tag--teal"><span class="strand-tag__text">Tag</span></span>"`;

exports[`renders > removable red 1`] = `"<span class="strand-tag strand-tag--solid strand-tag--red"><span class="strand-tag__text">Tag</span><button type="button" aria-label="Remove" class="strand-tag__remove"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></span>"`;

exports[`renders > solid default 1`] = `"<span class="strand-tag strand-tag--solid strand-tag--default"><span class="strand-tag__text">Tag</span></span>"`;
