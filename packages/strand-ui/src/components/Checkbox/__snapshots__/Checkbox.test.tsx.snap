exports[`renders > checked 1`] = `"<label class="strand-checkbox"><input class="strand-checkbox__native strand-sr-only" type="checkbox"><span aria-hidden="true" class="strand-checkbox__control"><svg class="strand-checkbox__icon strand-checkbox__icon--check" fill="none" viewBox="0 0 16 16"><path d="M3.5 8L6.5 11L12.5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><svg class="strand-checkbox__icon strand-checkbox__icon--mixed" fill="none" viewBox="0 0 16 16"><line stroke="currentColor" stroke-linecap="round" stroke-width="2" x1="4" x2="12" y1="8" y2="8"></line></svg></span><span class="strand-checkbox__label">Accept</span></label>"`;

exports[`renders > compact no label 1`] = `"<label class="strand-checkbox strand-checkbox--compact"><input class="strand-checkbox__native strand-sr-only" type="checkbox"><span aria-hidden="true" class="strand-checkbox__control"><svg class="strand-checkbox__icon strand-checkbox__icon--check" fill="none" viewBox="0 0 16 16"><path d="M3.5 8L6.5 11L12.5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><svg class="strand-checkbox__icon strand-checkbox__icon--mixed" fill="none" viewBox="0 0 16 16"><line stroke="currentColor" stroke-linecap="round" stroke-width="2" x1="4" x2="12" y1="8" y2="8"></line></svg></span></label>"`;

exports[`renders > disabled checked 1`] = `"<label class="strand-checkbox"><input class="strand-checkbox__native strand-sr-only" disabled="" type="checkbox"><span aria-hidden="true" class="strand-checkbox__control"><svg class="strand-checkbox__icon strand-checkbox__icon--check" fill="none" viewBox="0 0 16 16"><path d="M3.5 8L6.5 11L12.5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><svg class="strand-checkbox__icon strand-checkbox__icon--mixed" fill="none" viewBox="0 0 16 16"><line stroke="currentColor" stroke-linecap="round" stroke-width="2" x1="4" x2="12" y1="8" y2="8"></line></svg></span><span class="strand-checkbox__label">Locked</span></label>"`;

exports[`renders > indeterminate 1`] = `"<label class="strand-checkbox"><input class="strand-checkbox__native strand-sr-only" type="checkbox"><span aria-hidden="true" class="strand-checkbox__control"><svg class="strand-checkbox__icon strand-checkbox__icon--check" fill="none" viewBox="0 0 16 16"><path d="M3.5 8L6.5 11L12.5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><svg class="strand-checkbox__icon strand-checkbox__icon--mixed" fill="none" viewBox="0 0 16 16"><line stroke="currentColor" stroke-linecap="round" stroke-width="2" x1="4" x2="12" y1="8" y2="8"></line></svg></span><span class="strand-checkbox__label">Some</span></label>"`;

