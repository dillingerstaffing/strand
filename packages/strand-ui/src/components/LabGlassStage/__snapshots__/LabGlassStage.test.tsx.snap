// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`every export renders its element and class > LabGlassPanel 1`] = `"<div class="strand-ref-glass-panel custom">x</div>"`;

exports[`every export renders its element and class > LabGlassStage 1`] = `"<div class="strand-ref-glass-stage custom">x</div>"`;

exports[`renders > stage 1`] = `"<div class="strand-ref-glass-stage">panel</div>"`;

exports[`stylesheet > renders these rules 1`] = `
".strand-ref-glass-stage { position: relative; padding: var(--strand-space-10) var(--strand-space-8); border-radius: var(--strand-radius-lg); overflow: hidden; background: radial-gradient(circle at 20% 30%, rgba(59, 142, 246, 0.45) 0%, transparent 55%), radial-gradient(circle at 80% 70%, rgba(20, 184, 166, 0.35) 0%, transparent 55%), linear-gradient(135deg, var(--strand-blue-midnight) 0%, var(--strand-blue-abyss) 100%) }
.strand-ref-glass-panel { position: relative; padding: 22px var(--strand-space-6); border-radius: var(--strand-radius-lg); background: rgba(15, 25, 42, 0.42); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2); border: 1px solid rgba(255, 255, 255, 0.16); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.12); color: var(--strand-on-blue-primary) }"
`;
