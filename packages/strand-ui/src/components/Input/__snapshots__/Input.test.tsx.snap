// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > addons 1`] = `"<div class="strand-input strand-input--has-leading strand-input--has-trailing"><span aria-hidden="true" class="strand-input__leading">$</span><input class="strand-input__field" type="text"><span aria-hidden="true" class="strand-input__trailing">.00</span></div>"`;

exports[`renders > disabled 1`] = `"<div class="strand-input strand-input--disabled"><input class="strand-input__field" disabled="" type="text"></div>"`;

exports[`renders > email error 1`] = `"<div class="strand-input strand-input--error"><input aria-invalid="true" class="strand-input__field" type="email"></div>"`;

exports[`renders > search 1`] = `"<div class="strand-input"><input class="strand-input__field" type="search"></div>"`;

exports[`renders > text 1`] = `"<div class="strand-input"><input class="strand-input__field" placeholder="Name" type="text"></div>"`;
