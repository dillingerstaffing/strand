// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > bounded value 1`] = `"<div class="strand-slider"><input type="range" min="10" max="50" step="5" aria-valuemin="10" aria-valuemax="50" aria-valuenow="25" class="strand-slider__field"></div>"`;

exports[`renders > default 1`] = `"<div class="strand-slider"><input type="range" min="0" max="100" step="1" aria-valuemin="0" aria-valuemax="100" class="strand-slider__field"></div>"`;

exports[`renders > disabled 1`] = `"<div class="strand-slider strand-slider--disabled"><input type="range" min="0" max="100" step="1" disabled="" aria-valuemin="0" aria-valuemax="100" class="strand-slider__field"></div>"`;
