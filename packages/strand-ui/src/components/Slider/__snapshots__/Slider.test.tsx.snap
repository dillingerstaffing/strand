// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > bounded value 1`] = `"<div class="strand-slider"><input aria-valuemax="50" aria-valuemin="10" aria-valuenow="25" class="strand-slider__field" max="50" min="10" step="5" type="range"></div>"`;

exports[`renders > default 1`] = `"<div class="strand-slider"><input aria-valuemax="100" aria-valuemin="0" class="strand-slider__field" max="100" min="0" step="1" type="range"></div>"`;

exports[`renders > disabled 1`] = `"<div class="strand-slider strand-slider--disabled"><input aria-valuemax="100" aria-valuemin="0" class="strand-slider__field" disabled="" max="100" min="0" step="1" type="range"></div>"`;
