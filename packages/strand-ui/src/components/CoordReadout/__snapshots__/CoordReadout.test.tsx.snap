  ".strand-coord-readout",
  ".strand-coord-readout::before",
  "@keyframes strand-coord-blink",
  "  0%, 49%",
  "  50%, 100%",
  ".strand-coord-readout__lat, .strand-coord-readout__lng",
  "@media (max-width: 640px)",
  "  .strand-coord-readout",
]
`;
