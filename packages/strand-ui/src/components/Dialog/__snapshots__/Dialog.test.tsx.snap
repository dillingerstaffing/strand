exports[`renders > closed 1`] = `""`;

exports[`renders > end aligned sm 1`] = `"<div class="strand-dialog__backdrop"><div aria-label="Sheet" aria-modal="true" class="strand-dialog__panel strand-dialog__panel--align-end strand-dialog__panel--pad-sm" role="dialog" tabindex="-1"><button aria-label="Close" class="strand-dialog__close" type="button">×</button><div class="strand-dialog__body">Body</div></div></div>"`;

exports[`renders > open with title 1`] = `"<div class="strand-dialog__backdrop"><div aria-labelledby="strand-dialog-title-41" aria-modal="true" class="strand-dialog__panel strand-dialog__panel--pad-lg" role="dialog" tabindex="-1"><div class="strand-dialog__header"><h2 class="strand-dialog__title" id="strand-dialog-title-41">Confirm</h2></div><button aria-label="Close" class="strand-dialog__close" type="button">×</button><div class="strand-dialog__body">Are you sure?</div></div></div>"`;

exports[`renders > start aligned no padding not dismissible 1`] = `"<div class="strand-dialog__backdrop"><div aria-label="Palette" aria-modal="true" class="strand-dialog__panel strand-dialog__panel--align-start strand-dialog__panel--pad-none" role="dialog" tabindex="-1"><div class="strand-dialog__body">Body</div></div></div>"`;
