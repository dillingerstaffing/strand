// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders > error 1`] = `"<div class="strand-form-field strand-form-field--error"><label class="strand-form-field__label" for="email">Email</label><div class="strand-form-field__control">control</div><p class="strand-form-field__error" id="email-error" role="alert">Required</p></div>"`;

exports[`renders > hint required 1`] = `"<div class="strand-form-field"><label class="strand-form-field__label" for="email">Email<span aria-hidden="true" class="strand-form-field__required">*</span></label><div class="strand-form-field__control">control</div><p class="strand-form-field__hint" id="email-hint">Work email</p></div>"`;

exports[`renders > label only 1`] = `"<div class="strand-form-field"><label class="strand-form-field__label" for="email">Email</label><div class="strand-form-field__control">control</div></div>"`;

exports[`renders > success 1`] = `"<div class="strand-form-field strand-form-field--success"><label class="strand-form-field__label" for="name">Name</label><div class="strand-form-field__control">control</div><p class="strand-form-field__success" id="name-success" role="status">Available</p></div>"`;
