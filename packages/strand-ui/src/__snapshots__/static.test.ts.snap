// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`stylesheet > renders these rules 1`] = `
".strand-static { pointer-events: none }
.strand-static [disabled], .strand-static [aria-disabled="true"] { opacity: 1; cursor: default }
.strand-static .strand-btn:disabled { opacity: 1; cursor: default }
.strand-static .strand-toast { position: static }
.strand-static .strand-tooltip { position: static }
.strand-static *, .strand-static *::before, .strand-static *::after { transition: none !important; animation: none !important }"
`;
