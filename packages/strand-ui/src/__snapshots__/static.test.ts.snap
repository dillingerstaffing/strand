// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`stylesheet > declares its selectors 1`] = `
[
  ".strand-static",
  ".strand-static [disabled], .strand-static [aria-disabled="true"]",
  ".strand-static .strand-btn:disabled",
  ".strand-static .strand-toast",
  ".strand-static .strand-tooltip",
  ".strand-static *, .strand-static *::before, .strand-static *::after",
]
`;
