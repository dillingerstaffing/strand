{
	"name": "strand",
	"version": "0.47.0",
	"private": true,
	"description": "Strand Design Language and UI Component Library",
	"author": "Dillinger Staffing <engineering@dillingerstaffing.com> (https://dillingerstaffing.com)",
	"license": "MIT",
	"homepage": "https://dillingerstaffing.com/labs/strand",
	"repository": {
		"type": "git",
		"url": "https://github.com/dillingerstaffing/strand"
	},
	"bugs": {
		"url": "https://github.com/dillingerstaffing/strand/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"build": "pnpm -r build && node scripts/measure-bundle.mjs",
		"measure-bundle": "node scripts/measure-bundle.mjs",
		"release": "node scripts/release.mjs",
		"test": "pnpm -r test",
		"test:component-test-parity": "node scripts/component-test-parity.mjs",
		"test:css-export-parity": "node scripts/css-export-parity.mjs",
		"test:parity": "node scripts/parity-check.mjs",
		"test:migration-staleness": "node scripts/migration-staleness.mjs",
		"test:contrast": "node scripts/contrast-check.mjs",
		"test:browser-preflight": "node scripts/browser-preflight.mjs",
		"test:layout": "node scripts/layout-check.mjs",
		"test:motion": "node scripts/motion-check.mjs",
		"test:all": "pnpm test:browser-preflight && pnpm test && pnpm test:css-export-parity && pnpm test:component-test-parity && pnpm test:parity && pnpm test:migration-staleness && pnpm test:contrast && pnpm test:doc-contrast && pnpm test:bundle-budget && pnpm test:layout && pnpm test:dark-composition && pnpm test:motion",
		"vendor-fonts": "node scripts/vendor-fonts.mjs",
		"vendor-fonts:check": "node scripts/vendor-fonts.mjs --check",
		"sync-versions": "node scripts/sync-versions.mjs",
		"sync-versions:check": "node scripts/sync-versions.mjs --check",
		"dogfood": "node scripts/dogfood-scaffold.mjs",
		"audit-dogfood": "node scripts/dogfood-audit.mjs",
		"purity-scan": "node scripts/purity-scan.mjs",
		"build:docs": "node scripts/build-docs.mjs",
		"test:scripts": "vitest run --config vitest.config.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test:doc-contrast": "node scripts/doc-contrast-check.mjs",
		"test:bundle-budget": "node scripts/bundle-budget-check.mjs",
		"test:dark-composition": "node scripts/dark-composition-check.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"playwright": "^1.62.1",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
